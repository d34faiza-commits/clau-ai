# --- Login (generate with: npm run setup) ---
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Path to the PHP CLI binary used to read PHP version/limits (default: php)
# Example for LiteSpeed: /usr/local/lsws/lsphp74/bin/php
PHP_BINARY=php

# Mount point shown in the Disk Usage card (default: /)
DISK_PATH=/

# Folder the File Manager can access; nothing outside it is reachable.
# Default: /var/www if it exists, otherwise the home folder of the app user.
FILE_MANAGER_ROOT=/var/www

# Max size per uploaded file in MB (also raise client_max_body_size in Nginx)
MAX_UPLOAD_MB=100

# --- Database page (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# Where the AI Chat provider settings are stored (default: ./data)
# DATA_DIR=/opt/clau-ai/data
